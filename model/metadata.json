    "batch_size": 16,
    "optimizer": "AdamW",
    "learning_rate": 2e-05,
    "test_macro_f1": 0.6835,
    "test_micro_f1": 0.8007,
    "optimized_test_macro_f1": 0.6885,
    "optimized_test_micro_f1": 0.7988,
    "explainability": "SHAP"
}