{
    "project": "ToxicGuard AI",
    "model": "bert-base-uncased",
    "task": "Multi-label Toxic Comment Classification",
    "categories": [
        "toxic",
        "severe_toxic",
        "obscene",
        "threat",
        "insult",
        "identity_hate"
