# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud -> App settings -> Secrets.
# NEVER commit the real secrets.toml.

# Your fine-tuned model on the Hugging Face Hub (pushed by the Colab notebook).
# Leave unset to use the public fallback model "unitary/toxic-bert".
MODEL_ID = "your-hf-username/toxicguard-mbert"

# Only needed if the model repo is private.
# HF_TOKEN = "hf_..."

# LLM for the GenAI explanations (CO4) - set ONE of these. Without a key the app uses offline template mode.
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY = "AIza..."
# GEMINI_MODEL = "gemini-3.8-flash"   # optional override
# ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: official Google Cloud Translation API key. Without it the public Google endpoint is used.
# GOOGLE_TRANSLATE_API_KEY = "AIza..."
